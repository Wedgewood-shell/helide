+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_HELIUM_SMART_SIDEBAR_COLLAPSE_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_HELIUM_SMART_SIDEBAR_COLLAPSE_H_
+
+#include <optional>
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "ui/views/view.h"
+#include "ui/views/view_observer.h"
+
+class BrowserView;
+
+namespace helium {
+
+// Smart sidebar collapse, for the vertical tab layout. The width of the
+// window alone decides: narrower than 65% of the screen, the tab strip
+// collapses; wider, it expands. This is applied when the window opens and
+// whenever its width changes, so a collapse or expand by hand (or Synergy
+// mode expanding the strip for the address bar) holds until the next resize.
+class SmartSidebarCollapse final : public views::ViewObserver {
+ public:
+  explicit SmartSidebarCollapse(BrowserView* browser_view);
+  SmartSidebarCollapse(const SmartSidebarCollapse&) = delete;
+  SmartSidebarCollapse& operator=(const SmartSidebarCollapse&) = delete;
+  ~SmartSidebarCollapse() override;
+
+  // Whether a window `window_width` wide should have a collapsed strip on a
+  // screen `screen_width` wide.
+  static bool ShouldCollapse(int window_width, int screen_width);
+
+  // views::ViewObserver:
+  void OnViewBoundsChanged(views::View* observed_view) override;
+  void OnViewIsDeleting(views::View* observed_view) override;
+
+ private:
+  bool IsEnabled() const;
+  // Applies the width rule on the next turn of the message loop, outside of
+  // layout. `force` applies it even if the width has not changed.
+  void ScheduleApply(bool force);
+  void Apply();
+
+  raw_ptr<BrowserView> browser_view_;
+  base::ScopedObservation<views::View, views::ViewObserver>
+      browser_view_observation_{this};
+  PrefChangeRegistrar pref_change_registrar_;
+  base::CallbackListSubscription mode_subscription_;
+
+  // The width last applied, so moves and height changes do nothing.
+  std::optional<int> last_width_;
+  bool apply_pending_ = false;
+  bool force_pending_ = false;
+
+  base::WeakPtrFactory<SmartSidebarCollapse> weak_factory_{this};
+};
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_HELIUM_SMART_SIDEBAR_COLLAPSE_H_
