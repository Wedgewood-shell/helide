+void TabScrubGlowView::PaintPillBody(gfx::Canvas* canvas,
+                                     const Shape& shape) {
+  const SkColor background = SkColorSetA(
+      GetColorProvider()->GetColor(kColorTabBackgroundActiveFrameActive),
+      SK_AlphaOPAQUE);
+
+  // An opaque body with a soft shadow, so the title reads over the page.
+  cc::PaintFlags body_flags;
+  body_flags.setAntiAlias(true);
+  body_flags.setColor(background);
+  body_flags.setLooper(gfx::CreateShadowDrawLooper({gfx::ShadowValue(
+      gfx::Vector2d(0, kPillShadowOffsetY), kPillShadowBlur,
+      SkColorSetA(SK_ColorBLACK, 0x40))}));
+  canvas->DrawRoundRect(shape.bounds, shape.corner_radius, body_flags);
+}
+
+void TabScrubGlowView::PaintPillLabels(gfx::Canvas* canvas,
+                                       const Shape& shape) {
+  const ui::ColorProvider* provider = GetColorProvider();
+  const SkColor foreground =
+      provider->GetColor(kColorTabForegroundActiveFrameActive);
+
+  // The end over the tab holds the favicon, where the tab shows it.
+  const float icon_width = std::min(shape.icon_area_width, shape.bounds.width());
+  const gfx::RectF icon_area(
+      shape.grows_left ? shape.bounds.right() - icon_width : shape.bounds.x(),
+      shape.bounds.y(), icon_width, shape.bounds.height());
+  const gfx::RectF title_area(
+      shape.grows_left ? shape.bounds.x() + kPillEndPadding : icon_area.right(),
+      shape.bounds.y(),
+      std::max(0.0f,
+               shape.bounds.width() - icon_width - kPillEndPadding),
+      shape.bounds.height());
+
+  gfx::ScopedCanvas clip_scope(canvas);
+  canvas->ClipRect(gfx::ToEnclosingRect(shape.bounds));
+  for (const Label& label : shape.labels) {
+    if (label.opacity <= 0.0f) {
+      continue;
+    }
+    canvas->SaveLayerAlpha(
+        static_cast<uint8_t>(std::clamp(label.opacity, 0.0f, 1.0f) * 255));
+
+    if (!label.favicon.IsEmpty()) {
+      const gfx::ImageSkia favicon = label.favicon.Rasterize(provider);
+      if (!favicon.isNull()) {
+        const gfx::PointF center = icon_area.CenterPoint();
+        canvas->DrawImageInt(favicon, 0, 0, favicon.width(), favicon.height(),
+                             static_cast<int>(
+                                 std::round(center.x() - kFaviconSize / 2.0f)),
+                             static_cast<int>(
+                                 std::round(center.y() - kFaviconSize / 2.0f)),
+                             kFaviconSize, kFaviconSize, /*filter=*/true);
+      }
+    }
+
+    if (!label.title.empty() && title_area.width() > 0) {
+      canvas->DrawStringRectWithFlags(
+          label.title, PillFont(), foreground,
+          gfx::ToEnclosingRect(title_area),
+          shape.grows_left ? gfx::Canvas::TEXT_ALIGN_RIGHT
+                           : gfx::Canvas::TEXT_ALIGN_LEFT);
+    }
+    canvas->Restore();
   }
 }
 
