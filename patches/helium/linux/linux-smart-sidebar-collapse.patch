+bool TabScrubber::IsStripCollapsed(bool* right_aligned) {
+  *right_aligned = false;
+  auto* browser_view = static_cast<BrowserView*>(browser_view_.view());
+  if (!browser_view) {
+    return false;
+  }
+  const auto* controller =
+      tabs::VerticalTabStripStateController::From(browser_view->browser());
+  if (!controller || !controller->ShouldDisplayVerticalTabs()) {
+    return false;
+  }
+  *right_aligned = controller->IsTabStripRightAligned();
+  return controller->IsCollapsed();
+}
+
+std::optional<TabScrubber::Pill> TabScrubber::PillForTab(
+    const views::View* view) {
+  bool right_aligned = false;
+  if (!IsStripCollapsed(&right_aligned)) {
+    return std::nullopt;
+  }
+  // Only tabs drawn as icons; a collapsed strip expanded under the pointer
+  // shows its titles itself.
+  const TabView* tab_view = views::AsViewClass<TabView>(view);
+  if (!tab_view || tab_view->width() > kIconTabMaxWidth) {
+    return std::nullopt;
+  }
+  Pill pill;
+  pill.label.title = tab_view->data().title;
+  if (tab_view->data().should_display_favicon) {
+    pill.label.favicon = tab_view->data().favicon;
+  }
+  const gfx::RectF tab_bounds = BoundsInBrowserView(view);
+  pill.icon_area_width = tab_bounds.width();
+  pill.grows_left = right_aligned;
+  const float width =
+      TabScrubGlowView::PillWidth(pill.label.title, tab_bounds.width());
+  pill.bounds = tab_bounds;
+  pill.bounds.set_width(width);
+  if (right_aligned) {
+    pill.bounds.set_x(tab_bounds.right() - width);
+  }
+  return pill;
+}
+
+TabScrubGlowView::Shape TabScrubber::TabShape(
+    const views::View* low,
+    const views::View* high,
+    double fraction,
+    const std::optional<gfx::Rect>& strip_clip,
+    const std::optional<gfx::Rect>& pill_clip) {
+  TabScrubGlowView::Shape shape;
+  shape.corner_radius = kTabCornerRadius;
+
+  std::optional<Pill> low_pill = PillForTab(low);
+  std::optional<Pill> high_pill = PillForTab(high);
+  if (!low_pill && !high_pill) {
+    shape.bounds = Lerp(BoundsInBrowserView(low), BoundsInBrowserView(high),
+                        fraction);
+    shape.clip = strip_clip;
+    return shape;
+  }
+
+  // In a collapsed strip the glow is a pill with the title, which slides and
+  // stretches from one tab's pill to the next while the titles cross-fade.
+  const auto bounds_of = [this](const std::optional<Pill>& pill,
+                                const views::View* view) {
+    return pill ? pill->bounds : BoundsInBrowserView(view);
+  };
+  const auto icon_width_of = [this](const std::optional<Pill>& pill,
+                                    const views::View* view) {
+    return pill ? pill->icon_area_width : BoundsInBrowserView(view).width();
+  };
+  shape.bounds =
+      Lerp(bounds_of(low_pill, low), bounds_of(high_pill, high), fraction);
+  shape.icon_area_width = static_cast<float>(
+      icon_width_of(low_pill, low) +
+      (icon_width_of(high_pill, high) - icon_width_of(low_pill, low)) *
+          fraction);
+  shape.grows_left = (low_pill ? low_pill : high_pill)->grows_left;
+  shape.clip = pill_clip;
+  // The titles swap over the middle part of the way, so two of them overlap
+  // only briefly.
+  const float high_opacity =
+      low == high ? 0.0f
+                  : static_cast<float>(std::clamp(
+                        (fraction - kLabelFadeStart) /
+                            (1.0 - 2 * kLabelFadeStart),
+                        0.0, 1.0));
+  if (low_pill) {
+    low_pill->label.opacity = 1.0f - high_opacity;
+    shape.labels.push_back(std::move(low_pill->label));
+  }
+  if (high_pill && low != high) {
+    high_pill->label.opacity = high_opacity;
+    shape.labels.push_back(std::move(high_pill->label));
+  }
+  return shape;
 }
 
