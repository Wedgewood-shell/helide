+
+bool TabScrubber::IsStripCollapsed(bool* right_aligned) {
+  *right_aligned = false;
+  auto* browser_view = static_cast<BrowserView*>(browser_view_.view());
+  if (!browser_view) {
+    return false;
+  }
+  const auto* controller =
+      tabs::VerticalTabStripStateController::From(browser_view->browser());
+  if (!controller || !controller->ShouldDisplayVerticalTabs()) {
+    return false;
+  }
+  *right_aligned = controller->IsTabStripRightAligned();
+  return controller->IsCollapsed();
+}
+
+std::optional<TabScrubber::Pill> TabScrubber::PillForTab(
+    const views::View* view) {
+  bool right_aligned = false;
+  if (!IsStripCollapsed(&right_aligned)) {
+    return std::nullopt;
+  }
+  // Only tabs drawn as icons; a collapsed strip expanded under the pointer
+  // shows its titles itself.
+  const TabView* tab_view = views::AsViewClass<TabView>(view);
+  if (!tab_view || tab_view->width() > kIconTabMaxWidth) {
+    return std::nullopt;
+  }
+  Pill pill;
+  pill.label.title = tab_view->data().title;
+  if (tab_view->data().should_display_favicon) {
+    pill.label.favicon = tab_view->data().favicon;
+  }
+  pill.tab_bounds = BoundsInBrowserView(view);
+  pill.title_width = TabScrubGlowView::TitleWidth(pill.label.title);
+  pill.grows_left = right_aligned;
+  return pill;
+}
+
+// static
+TabScrubGlowView::Shape TabScrubber::PillShape(const Pill& pill,
+                                               double amplitude) {
+  TabScrubGlowView::Shape shape;
+  shape.corner_radius = kTabCornerRadius;
+  shape.label = pill.label;
+  shape.icon_area_width = pill.tab_bounds.width();
+  shape.title_width = pill.title_width;
+  shape.grows_left = pill.grows_left;
+  shape.strength = static_cast<float>(amplitude);
+
+  const float tab_width = pill.tab_bounds.width();
+  const float full_width =
+      TabScrubGlowView::PillWidth(pill.title_width, tab_width);
+  const double grown =
+      gfx::Tween::CalculateValue(gfx::Tween::EASE_IN_OUT, amplitude);
+  const float width =
+      static_cast<float>(tab_width + (full_width - tab_width) * grown);
+  shape.bounds = pill.tab_bounds;
+  shape.bounds.set_width(width);
+  if (pill.grows_left) {
+    shape.bounds.set_x(pill.tab_bounds.right() - width);
+  }
+  return shape;
+}
+
+void TabScrubber::AddTabShapes(
+    const views::View* low,
+    const views::View* high,
+    double fraction,
+    const std::optional<gfx::Rect>& strip_clip,
+    const std::optional<gfx::Rect>& pill_clip,
+    std::vector<TabScrubGlowView::Shape>& shapes) {
+  const std::optional<Pill> low_pill = PillForTab(low);
+  const std::optional<Pill> high_pill = PillForTab(high);
+  if (!low_pill && !high_pill) {
+    // An expanded strip: one glow slides from tab to tab.
+    TabScrubGlowView::Shape shape;
+    shape.corner_radius = kTabCornerRadius;
+    shape.bounds = Lerp(BoundsInBrowserView(low), BoundsInBrowserView(high),
+                        fraction);
+    shape.clip = strip_clip;
+    shapes.push_back(std::move(shape));
+    return;
+  }
+
+  // A collapsed strip: a standing wave. Every tab keeps its place and its
+  // pill swells and subsides as the swipe passes over it. Between two tabs,
+  // the one behind shrinks back into the strip while the one ahead grows out.
+  const auto add = [&](const views::View* view,
+                       const std::optional<Pill>& pill, double amplitude) {
+    if (amplitude <= kMinPillAmplitude) {
+      return;
+    }
+    TabScrubGlowView::Shape shape;
+    if (pill) {
+      shape = PillShape(*pill, amplitude);
+      shape.clip = pill_clip;
+    } else {
+      shape.corner_radius = kTabCornerRadius;
+      shape.bounds = BoundsInBrowserView(view);
+      shape.strength = static_cast<float>(amplitude);
+      shape.clip = strip_clip;
+    }
+    shapes.push_back(std::move(shape));
+  };
+  if (low == high) {
+    add(low, low_pill, 1.0);
+    return;
+  }
+  add(low, low_pill, 1.0 - fraction);
+  add(high, high_pill, fraction);
 }
 
