+// Copyright 2026 The Helide Authors
+// Use of this source code is governed by the GPL-3.0 license in LICENSE.
+
+#ifndef CHROME_COMMON_HELIUM_SMART_SIDEBAR_PREFS_H_
+#define CHROME_COMMON_HELIUM_SMART_SIDEBAR_PREFS_H_
+
+namespace helium {
+
+// Linux only. A boolean pref, on by default. With the vertical tab layout,
+// the tab strip collapses while the window is narrower than
+// kSmartSidebarCollapseScreenFraction of the screen's width, and expands
+// while it is wider.
+inline constexpr char kSmartSidebarCollapse[] =
+    "helium.browser.smart_sidebar_collapse";
+
+inline constexpr double kSmartSidebarCollapseScreenFraction = 0.65;
+
+}  // namespace helium
+
+#endif  // CHROME_COMMON_HELIUM_SMART_SIDEBAR_PREFS_H_
