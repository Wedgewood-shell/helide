+void TabScrubGlowView::PaintPillBody(gfx::Canvas* canvas,
+                                     const Shape& shape) {
+  const SkColor background = SkColorSetA(
+      GetColorProvider()->GetColor(kColorTabBackgroundActiveFrameActive),
+      SK_AlphaOPAQUE);
+
+  // An opaque body with a soft shadow, so the title reads over the page.
+  cc::PaintFlags body_flags;
+  body_flags.setAntiAlias(true);
+  body_flags.setColor(background);
+  body_flags.setLooper(gfx::CreateShadowDrawLooper({gfx::ShadowValue(
+      gfx::Vector2d(0, kPillShadowOffsetY), kPillShadowBlur,
+      SkColorSetA(SK_ColorBLACK, 0x40))}));
+  canvas->DrawRoundRect(shape.bounds, shape.corner_radius, body_flags);
