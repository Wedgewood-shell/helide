+// Copyright 2026 The Helide Authors
+// Use of this source code is governed by the GPL-3.0 license in LICENSE.
+
+#include "chrome/browser/ui/views/helium/helium_smart_sidebar_collapse.h"
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/common/helium_smart_sidebar_prefs.h"
+#include "components/prefs/pref_service.h"
+#include "ui/display/display.h"
+#include "ui/display/screen.h"
+#include "ui/views/widget/widget.h"
+
+namespace helium {
+
+SmartSidebarCollapse::SmartSidebarCollapse(BrowserView* browser_view)
+    : browser_view_(browser_view) {
+  browser_view_observation_.Observe(browser_view_);
+  pref_change_registrar_.Init(browser_view_->GetProfile()->GetPrefs());
+  pref_change_registrar_.Add(
+      kSmartSidebarCollapse,
+      base::BindRepeating(&SmartSidebarCollapse::ScheduleApply,
+                          base::Unretained(this), /*force=*/true));
+  ScheduleApply(/*force=*/true);
+}
+
+SmartSidebarCollapse::~SmartSidebarCollapse() = default;
+
+// static
+bool SmartSidebarCollapse::ShouldCollapse(int window_width, int screen_width) {
+  return window_width < screen_width * kSmartSidebarCollapseScreenFraction;
+}
+
+void SmartSidebarCollapse::OnViewBoundsChanged(views::View* observed_view) {
+  ScheduleApply(/*force=*/false);
+}
+
+void SmartSidebarCollapse::OnViewIsDeleting(views::View* observed_view) {
+  browser_view_observation_.Reset();
+  mode_subscription_ = {};
+  pref_change_registrar_.RemoveAll();
+  browser_view_ = nullptr;
+}
+
+bool SmartSidebarCollapse::IsEnabled() const {
+  return browser_view_ &&
+         browser_view_->GetProfile()->GetPrefs()->GetBoolean(
+             kSmartSidebarCollapse);
+}
+
+void SmartSidebarCollapse::ScheduleApply(bool force) {
+  force_pending_ |= force;
+  if (apply_pending_) {
+    return;
+  }
+  apply_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&SmartSidebarCollapse::Apply,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void SmartSidebarCollapse::Apply() {
+  apply_pending_ = false;
+  const bool force = force_pending_;
+  force_pending_ = false;
+  if (!browser_view_ || !IsEnabled()) {
+    return;
+  }
+
+  auto* controller =
+      tabs::VerticalTabStripStateController::From(browser_view_->browser());
+  if (!controller) {
+    return;
+  }
+  // Switching to the vertical layout applies the rule too.
+  if (!mode_subscription_) {
+    mode_subscription_ = controller->RegisterOnModeChanged(base::BindRepeating(
+        [](SmartSidebarCollapse* self,
+           tabs::VerticalTabStripStateController*) {
+          self->ScheduleApply(/*force=*/true);
+        },
+        base::Unretained(this)));
+  }
+  if (!controller->ShouldDisplayVerticalTabs()) {
+    return;
+  }
+
+  views::Widget* widget = browser_view_->GetWidget();
+  if (!widget || widget->IsMinimized() ||
+      browser_view_->IsFullscreen()) {
+    return;
+  }
+
+  const int window_width = browser_view_->width();
+  if (window_width <= 0) {
+    return;
+  }
+  if (!force && last_width_ == window_width) {
+    return;
+  }
+  const display::Display display =
+      display::Screen::Get()->GetDisplayNearestView(widget->GetNativeView());
+  const int screen_width = display.bounds().width();
+  if (screen_width <= 0) {
+    return;
+  }
+  last_width_ = window_width;
+
+  const bool collapse = ShouldCollapse(window_width, screen_width);
+  // Collapsed, or on the way there.
+  const bool collapsed = controller->GetCollapseState() !=
+                         tabs::VerticalTabStripCollapseState::kExpanded;
+  VLOG(1) << "Smart sidebar: window " << window_width << " of screen "
+          << screen_width << ", collapse=" << collapse
+          << " collapsed=" << collapsed;
+  if (collapse != collapsed) {
+    controller->RequestCollapse(collapse);
+  }
+}
+
+}  // namespace helium
