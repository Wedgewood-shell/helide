+// Helide: Helium kept its profile in net.imput.helium, with pref keys under
+// "helium" and about:flags entries named helium-*. Helide renamed all three.
+constexpr char kHeliumDataDirBasename[] = "net.imput.helium";
+constexpr char kHeliumPrefsKey[] = "helium";
+constexpr char kHelidePrefsKey[] = "helide";
+constexpr std::string_view kHeliumFlagPrefix = "helium-";
+constexpr std::string_view kHelideFlagPrefix = "helide-";
+
+// Whether a browser still runs on `dir`: its SingletonLock points at
+// "<host>-<pid>".
+bool IsProfileDirInUse(const base::FilePath& dir) {
+  base::FilePath target;
+  if (!base::ReadSymbolicLink(dir.Append("SingletonLock"), &target)) {
+    return false;
+  }
+  const std::string& lock = target.value();
+  const size_t dash = lock.rfind('-');
+  int pid = 0;
+  if (dash == std::string::npos ||
+      !base::StringToInt(std::string_view(lock).substr(dash + 1), &pid) ||
+      pid <= 0) {
+    return false;
+  }
+  return kill(pid, 0) == 0 || errno == EPERM;
+}
+
+// Moves the "helium" pref dictionary to "helide" in one JSON prefs file, and
+// renames helium-* about:flags entries in Local State.
+void RenamePrefsInFile(const base::FilePath& path) {
+  std::string json;
+  if (!base::ReadFileToString(path, &json)) {
+    return;
+  }
+  std::optional<base::Value> root = base::JSONReader::Read(
+      json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!root || !root->is_dict()) {
+    LOG(WARNING) << "Helide: could not read " << path;
+    return;
+  }
+  base::DictValue& dict = root->GetDict();
+  bool changed = false;
+  if (std::optional<base::Value> old_prefs = dict.Extract(kHeliumPrefsKey)) {
+    if (old_prefs->is_dict()) {
+      base::DictValue merged = std::move(old_prefs->GetDict());
+      // Anything already under the new key wins.
+      if (const base::DictValue* existing = dict.FindDict(kHelidePrefsKey)) {
+        merged.Merge(existing->Clone());
+      }
+      dict.Set(kHelidePrefsKey, std::move(merged));
+    }
+    changed = true;
+  }
+  if (base::ListValue* flags =
+          dict.FindListByDottedPath("browser.enabled_labs_experiments")) {
+    for (base::Value& flag : *flags) {
+      if (flag.is_string() && flag.GetString().starts_with(kHeliumFlagPrefix)) {
+        flag = base::Value(std::string(kHelideFlagPrefix) +
+                           flag.GetString().substr(kHeliumFlagPrefix.size()));
+        changed = true;
+      }
+    }
+  }
+  if (!changed) {
+    return;
+  }
+  std::optional<std::string> output = base::WriteJson(*root);
+  if (!output || !base::ImportantFileWriter::WriteFileAtomically(path, *output)) {
+    LOG(WARNING) << "Helide: could not rewrite " << path;
+  }
+}
+
+// Moves a Helium profile directory to Helide's, once, and leaves a symlink
+// behind so tools that still look in the old place find it. Returns false if
+// the old directory must stay in use for now (an old browser runs on it).
+bool MigrateHeliumUserDataDir(const base::FilePath& old_dir,
+                              const base::FilePath& new_dir) {
+  if (base::PathExists(new_dir) || base::IsLink(old_dir) ||
+      !base::DirectoryExists(old_dir)) {
+    return true;
+  }
+  if (IsProfileDirInUse(old_dir)) {
+    LOG(WARNING) << "Helide: " << old_dir
+                 << " is in use by another browser; not moving it yet";
+    return false;
+  }
+  if (rename(old_dir.value().c_str(), new_dir.value().c_str()) != 0) {
+    PLOG(WARNING) << "Helide: could not move " << old_dir << " to " << new_dir;
+    return false;
+  }
+  if (!base::CreateSymbolicLink(new_dir.BaseName(), old_dir)) {
+    PLOG(WARNING) << "Helide: could not link " << old_dir;
+  }
+
+  RenamePrefsInFile(new_dir.Append("Local State"));
+  base::FileEnumerator profiles(new_dir, /*recursive=*/false,
+                                base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath profile = profiles.Next(); !profile.empty();
+       profile = profiles.Next()) {
+    RenamePrefsInFile(profile.Append("Preferences"));
+    RenamePrefsInFile(profile.Append("Secure Preferences"));
+  }
+  LOG(WARNING) << "Helide: moved the profile from " << old_dir << " to "
+               << new_dir;
+  return true;
+}
+
+// The cache follows the profile directory's name.
+void MigrateHeliumCacheDir(base::Environment* env,
+                           const std::string& old_basename,
+                           const std::string& new_basename) {
+  const base::FilePath cache_home =
+      base::nix::GetXDGDirectory(env, "XDG_CACHE_HOME", ".cache");
+  const base::FilePath old_cache = cache_home.Append(old_basename);
+  const base::FilePath new_cache = cache_home.Append(new_basename);
+  if (base::DirectoryExists(old_cache) && !base::IsLink(old_cache) &&
+      !base::PathExists(new_cache) &&
+      rename(old_cache.value().c_str(), new_cache.value().c_str()) == 0) {
+    base::CreateSymbolicLink(new_cache.BaseName(), old_cache);
+  }
 }
 
